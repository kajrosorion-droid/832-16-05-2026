# МЕТОД: намеренная сигнализация
# ------------------------------------------------------------
def choose_intentional_signal(self):
    if not hasattr(self, 'signal_memory') or not self.signal_memory:
        self.last_intentional_signal = False
        return {}
    best_signal = None
    best_score = -999
    for (sig_type, resp_type), data in self.signal_memory.items():
        if data['count'] == 0:
            continue
        avg_grief = data['total_delta_grief'] / data['count']
        avg_grat = data['total_delta_gratitude'] / data['count']
        score = -avg_grief * 1.2 + avg_grat * 0.8
        if score > best_score:
            best_score = score
            best_signal = sig_type
    if best_signal is None:
        self.last_intentional_signal = False
        return {}
    channel_map = {
        "cooperate": CH['signal_gratitude'],
        "alarm": CH['signal_alarm'],
        "neutral": CH['signal_curiosity'],
        "seek_help": CH['intent_seek_help'],
        "explore": CH['intent_explore'],
    }
    channel = channel_map.get(best_signal)
    if channel is None:
        self.last_intentional_signal = False
        return {}
    confidence = min(1.0, self.signal_memory.get((best_signal, "helpful"), {}).get('count', 0) / 10)
    result = {channel: 0.3 * confidence}
    self.last_intentional_signal = True
    return result

